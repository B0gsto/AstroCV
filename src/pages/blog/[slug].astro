---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { render } from "astro:content";
import { getVisiblePosts, postCategory, readingTime } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // posts are newest first; "next" walks towards older notes and wraps around
    props: { post, nextPost: posts.length > 1 ? posts[(i + 1) % posts.length] : undefined },
  }));
}

const { post, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter((heading) => heading.depth === 2);

const formattedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(post.data.publishDate);
---

<BaseLayout title={`${post.data.title} — Bogdan Stoica`} description={post.data.description}>
  <div class="read-progress" aria-hidden="true"><span id="read-progress-bar"></span></div>

  <div class="container post-layout">
    <aside class="post-rail">
      <a href="/blog" class="back-link">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8H3M7 4L3 8l4 4"></path></svg>
        All field notes
      </a>
      {
        sections.length > 1 && (
          <nav class="toc" aria-label="On this page">
            {sections.map((heading) => (
              <a href={`#${heading.slug}`} data-toc={heading.slug}>{heading.text}</a>
            ))}
          </nav>
        )
      }
    </aside>

    <article class="post">
      <header class="post-header">
        <p class="post-meta animate-fade-in-up">
          <span class="post-category">{postCategory(post)}</span>
          <time datetime={post.data.publishDate.toISOString()}>{formattedDate}</time>
          <span>{readingTime(post)}</span>
          {post.data.draft && <span class="draft-chip">draft · hidden in production</span>}
        </p>
        <h1 class="post-title" transition:name={`post-${post.id}`}>{post.data.title}</h1>
        <p class="post-description animate-fade-in-up stagger-2">{post.data.description}</p>
      </header>

      {
        post.data.coverImage && (
          <div class="post-cover">
            <img src={post.data.coverImage} alt="" />
          </div>
        )
      }

      <div class="post-content prose">
        <Content />
      </div>

      <div class="post-tags">
        {post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
      </div>
    </article>
  </div>

  {
    nextPost && (
      <div class="container">
        <a class="next-post" href={`/blog/${nextPost.id}`}>
          <span class="next-text">
            <span class="next-label">Next field note</span>
            <span class="next-title">{nextPost.data.title}</span>
          </span>
          <svg class="next-arrow" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    )
  }
</BaseLayout>

<style>
  .read-progress {
    position: fixed;
    top: var(--header-height);
    left: 0;
    right: 0;
    z-index: 49;
    height: 2px;
    pointer-events: none;
    transition: top 0.5s var(--ease-out);
  }

  :global(html.header-hidden) .read-progress {
    top: 0;
  }

  .read-progress span {
    display: block;
    height: 100%;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .post-layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 80px;
    padding-top: clamp(48px, 7vw, 80px);
    padding-bottom: 72px;
  }

  /* ---- rail ---- */

  .post-rail {
    position: sticky;
    top: calc(var(--header-height) + 32px);
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 28px;
    font-size: 13px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 0;
    color: var(--color-text-secondary);
  }

  .back-link svg {
    transition: transform var(--transition-base);
  }

  .back-link:hover svg {
    transform: translateX(-4px);
  }

  .toc {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--color-border-strong);
  }

  .toc a {
    margin-left: -1px;
    padding: 7px 0 7px 14px;
    border-left: 1px solid transparent;
    color: var(--color-text-muted);
    line-height: 1.4;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .toc a:hover {
    color: var(--color-text);
  }

  .toc a.active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
  }

  /* ---- header ---- */

  .post {
    min-width: 0;
    max-width: 920px;
  }

  .post-header {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin-bottom: 48px;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 18px;
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .post-category {
    font-weight: 600;
    color: var(--color-text);
  }

  .draft-chip {
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.07);
    font-size: 11px;
    color: var(--color-text-secondary);
  }

  .post-title {
    font-size: clamp(2.1rem, 4.6vw, 3.75rem);
    line-height: 1.02;
  }

  .post-description {
    max-width: 760px;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.5;
  }

  .post-cover {
    margin-bottom: 48px;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .post-cover img {
    width: 100%;
    height: auto;
  }

  /* ---- prose ---- */

  .post-content {
    font-size: 18px;
    line-height: var(--line-height-relaxed);
  }

  .post-content :global(h1) {
    font-size: var(--text-3xl);
  }

  .post-content :global(h2) {
    font-size: clamp(1.6rem, 2.6vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin-top: 56px;
    margin-bottom: 16px;
  }

  .post-content :global(h3) {
    font-size: var(--text-xl);
    margin-top: 36px;
    margin-bottom: 12px;
  }

  .post-content :global(p),
  .post-content :global(li) {
    color: var(--color-text-prose);
  }

  .post-content :global(p) {
    margin-bottom: 20px;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 20px;
    padding-left: 22px;
  }

  .post-content :global(li) {
    margin-bottom: 8px;
  }

  .post-content :global(li::marker) {
    color: var(--color-accent);
  }

  .post-content :global(pre) {
    margin: 28px 0;
    /* code gets a little more room than the text column */
    width: min(820px, calc(100vw - 2 * var(--container-padding)));
  }

  .post-content :global(blockquote) {
    margin: 28px 0;
    padding: 4px 0 4px 20px;
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-secondary);
  }

  .post-content :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 4px;
  }

  .post-content :global(a:hover) {
    color: var(--color-accent);
  }

  .post-content :global(strong) {
    color: var(--color-text);
  }

  .post-content :global(table) {
    width: 100%;
    margin: 28px 0;
    border-collapse: collapse;
    font-size: 15px;
  }

  .post-content :global(th),
  .post-content :global(td) {
    padding: 12px 14px;
    border-bottom: 1px solid var(--color-border-strong);
    text-align: left;
    color: var(--color-text-prose);
  }

  .post-content :global(th) {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 48px;
  }

  /* ---- next ---- */

  .next-post {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 40px;
    gap: 40px;
    align-items: center;
    margin-bottom: 72px;
    padding: 40px 16px;
    border-top: 1px solid var(--color-border-strong);
    border-bottom: 1px solid var(--color-border-strong);
    color: var(--color-text);
    transition: background-color 250ms ease;
  }

  .next-post:hover {
    color: var(--color-text);
    background-color: var(--color-row-hover);
  }

  .next-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .next-label {
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .next-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .next-arrow {
    color: var(--color-text);
    transition: transform var(--transition-base);
  }

  .next-post:hover .next-arrow {
    transform: translateX(10px);
  }

  @media (max-width: 980px) {
    .post-layout {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .post-rail {
      position: static;
    }

    .toc {
      display: none;
    }
  }
</style>

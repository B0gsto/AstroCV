---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(post.data.publishDate);
---

<BaseLayout
  title={`${post.data.title} - Blog`}
  description={post.data.description}
>
  <article class="container blog-post animate-fade-in">
    <header class="post-header">
      <a href="/blog" class="back-link">← back to writing</a>

      <div class="post-meta">
        <time datetime={post.data.publishDate.toISOString()} class="mono-date">{formattedDate}</time>
        <span class="separator">·</span>
        <span class="read-time">5 min read</span>
      </div>

      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>

      <div class="post-tags">
        {post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
      </div>
    </header>

    {
      post.data.coverImage && (
        <div class="post-cover card">
          <img src={post.data.coverImage} alt={post.data.title} />
        </div>
      )
    }

    <div class="post-content prose">
      <Content />
    </div>

    <footer class="post-footer">
      <div class="share-section">
        <p>Liked the writeup? Check out other notes.</p>
        <a href="/blog" class="btn btn-secondary">view all writing</a>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .blog-post {
    max-width: 820px;
    padding-top: clamp(100px, 12vw, 150px);
    padding-bottom: 80px;
  }

  .post-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .back-link {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: 24px;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .post-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: 16px;
  }

  .separator {
    color: var(--color-accent);
  }

  .post-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin-bottom: 16px;
    letter-spacing: -0.03em;
  }

  .post-description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 660px;
    margin: 0 auto 28px;
    line-height: 1.6;
  }

  .post-tags {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .post-cover {
    margin-bottom: var(--space-12);
    border-radius: var(--radius-lg);
    overflow: hidden;
    padding: 0;
  }

  .post-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Prose styles */
  .post-content {
    line-height: var(--line-height-relaxed);
  }

  .post-content :global(h2) {
    font-size: var(--text-2xl);
    margin-top: 40px;
    margin-bottom: 16px;
    padding-top: 24px;
    border-top: 1px dashed var(--color-border);
  }

  .post-content :global(h3) {
    font-size: var(--text-xl);
    margin-top: 32px;
    margin-bottom: 12px;
  }

  .post-content :global(p) {
    margin-bottom: 20px;
    color: var(--color-text-secondary);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 20px;
    padding-left: 20px;
  }

  .post-content :global(li) {
    margin-bottom: 8px;
    color: var(--color-text-secondary);
  }

  .post-content :global(pre) {
    margin-bottom: 24px;
  }

  .post-content :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    padding-left: 20px;
    margin: 24px 0;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .post-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .post-content :global(strong) {
    color: var(--color-text);
  }

  .post-footer {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px dashed var(--color-border);
  }

  .share-section {
    text-align: center;
  }

  .share-section p {
    margin-bottom: 16px;
    font-size: 13px;
    color: var(--color-text-muted);
  }
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
  title="Writing — Bogdan Stoica"
  description="Technical notes about software engineering, integrations, cloud infrastructure and production reliability."
>
  <section class="section blog-page">
    <div class="container">
      <header class="page-header animate-fade-in-up">
        <span class="technical-label">Writing</span>
        <h1>Technical notes from production-minded engineering.</h1>
        <p>
          Short essays about integrations, cloud systems, automation, AI workflows and the reliability patterns I use while building.
        </p>
      </header>

      {
        sortedPosts.length === 0 ? (
          <div class="empty-state card">
            <p>No articles published yet. Check back soon.</p>
          </div>
        ) : (
          <div class="posts-grid">
            {sortedPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                publishDate={post.data.publishDate}
                tags={post.data.tags}
                slug={post.id}
                coverImage={post.data.coverImage}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .blog-page {
    padding-top: clamp(100px, 12vw, 150px);
  }

  .page-header {
    max-width: 720px;
    margin: 0 auto 56px;
    text-align: center;
  }

  .page-header .technical-label {
    justify-content: center;
  }

  .page-header h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 12px 0 16px;
    letter-spacing: -0.03em;
  }

  .page-header p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .empty-state {
    max-width: 480px;
    margin: 0 auto;
    padding: 32px;
    text-align: center;
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostVisual from "../../components/blog/PostVisual.astro";
import { getVisiblePosts, postCategory } from "../../lib/posts";

const posts = await getVisiblePosts();
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const otherPosts = posts.filter((post) => post !== featuredPost);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short" }).format(date);
---

<BaseLayout
  title="Writing — Bogdan Stoica"
  description="Field notes from building AI document automation on Azure: OCR benchmarks, Document Intelligence, Container Apps, microservices and reliability patterns."
>
  <section class="blog-page">
    <div class="container">
      <header class="page-header">
        <div>
          <span class="technical-label animate-fade-in-up">Field notes</span>
          <h1>
            <span class="line-mask"><span class="line-rise">What I learned</span></span>
            <span class="line-mask"><span class="line-rise"><span class="mark">in production.</span></span></span>
          </h1>
        </div>
        <p class="animate-fade-in-up stagger-2">
          Notes from building document automation on Azure alone: what I measured, what broke, and the design decisions
          I'd make again.
        </p>
      </header>

      {
        !featuredPost ? (
          <div class="empty-state card">
            <p>No articles published yet. Check back soon.</p>
          </div>
        ) : (
          <>
            <a class="featured card animate-fade-in-up stagger-3" href={`/blog/${featuredPost.id}`}>
              <div class="featured-body">
                <span class="featured-kicker">
                  {postCategory(featuredPost)}
                  {featuredPost.data.draft && <span class="draft-chip">draft</span>}
                </span>
                <h2 transition:name={`post-${featuredPost.id}`}>{featuredPost.data.title}</h2>
                <p>{featuredPost.data.description}</p>
              </div>
              {featuredPost.data.visual && (
                <div class="featured-visual"><PostVisual kind={featuredPost.data.visual} /></div>
              )}
            </a>

            <div class="row-list">
              {otherPosts.map((post, i) => (
                <a class="row post-row" href={`/blog/${post.id}`} data-reveal style={`--reveal-delay:${Math.min(i, 4) * 60}ms;`}>
                  <span class="row-kicker">
                    <span>{postCategory(post)} · {formatDate(post.data.publishDate)}</span>
                    {post.data.draft && <span class="draft-chip">draft</span>}
                  </span>
                  <span class="post-text">
                    <span class="row-title post-title" transition:name={`post-${post.id}`}>{post.data.title}</span>
                    <span class="row-desc">{post.data.description}</span>
                  </span>
                  <svg class="row-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </a>
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .blog-page {
    padding: clamp(56px, 8vw, 88px) 0 clamp(64px, 9vw, 112px);
  }

  .page-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 400px);
    gap: 24px 60px;
    align-items: end;
    margin-bottom: 56px;
  }

  .page-header h1 {
    font-size: clamp(2.6rem, 6vw, 5.25rem);
    line-height: 1.04;
  }

  .page-header p {
    font-size: 17px;
    line-height: 1.6;
    padding-bottom: 12px;
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 480px);
    gap: 32px 56px;
    align-items: center;
    margin-bottom: 72px;
    padding: 40px;
    color: var(--color-text);
  }

  .featured:hover {
    color: var(--color-text);
  }

  .featured-visual {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .featured-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .featured-kicker,
  .row-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 14px;
  }

  .featured-kicker {
    color: var(--color-text-muted);
  }

  .featured h2 {
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.06;
  }

  .featured p {
    max-width: 560px;
    font-size: 17px;
    line-height: 1.6;
  }

  .post-row {
    grid-template-columns: 190px minmax(0, 1fr) 24px;
    gap: 24px;
  }

  .post-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .post-title {
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .draft-chip {
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.07);
    font-size: 11px;
    color: var(--color-text-secondary);
  }

  .empty-state {
    max-width: 480px;
    padding: 32px;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .page-header,
    .featured {
      grid-template-columns: 1fr;
    }

    .featured {
      padding: 24px;
      margin-bottom: 48px;
    }
  }

  @media (max-width: 640px) {
    .post-row {
      grid-template-columns: minmax(0, 1fr) 20px;
    }

    .post-row .row-kicker {
      grid-column: 1 / -1;
    }
  }
</style>

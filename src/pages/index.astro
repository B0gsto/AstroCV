---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import Timeline from "../components/cv/Timeline.astro";
import SkillBar from "../components/cv/SkillBar.astro";

const cvSections = await getCollection("cv");
const sortedSections = cvSections.sort((a, b) => a.data.order - b.data.order);

// Skills based on LinkedIn profile
const skills = [
  { name: "UiPath", level: 95, category: "RPA" },
  { name: "REFramework", level: 90, category: "RPA" },
  { name: "Model Context Protocol", level: 35, category: "RPA" },
  { name: "REST APIs", level: 99, category: "Development" },
  { name: "React", level: 50, category: "Development" },
  { name: "React Native", level: 45, category: "Development" },
  { name: "C#", level: 30, category: "Development" },
  { name: "Java", level: 30, category: "Development" },
  { name: "TypeScript", level: 65, category: "Development" },
];
---

<BaseLayout
  title="Bogdan Stoica - UiPath RPA Engineer"
  description="Automation engineer with 2.6+ years delivering end-to-end UiPath solutions"
>
  <!-- Hero Section - Terminal Style -->
  <section class="hero">
    <div class="container">
      <div class="hero-content animate-fade-in-up">
        <div class="terminal-window">
          <div class="terminal-header">
            <span class="terminal-dot red"></span>
            <span class="terminal-dot yellow"></span>
            <span class="terminal-dot green"></span>
            <span class="terminal-title">bogdan@portfolio:~</span>
          </div>
          <div class="terminal-body">
            <div class="terminal-line">
              <span class="prompt">$</span>
              <span class="command">whoami</span>
            </div>
            <div class="terminal-output name-output">bogdan_stoica</div>

            <div class="terminal-line">
              <span class="prompt">$</span>
              <span class="command">cat</span> title.txt
            </div>
            <div class="terminal-output title-output">UiPath RPA Engineer</div>

            <div class="terminal-line">
              <span class="prompt">$</span>
              <span class="command">echo</span> $DESCRIPTION
            </div>
            <div class="terminal-output desc-output">
              Automation engineer with 2.6+ years delivering<br />
              end-to-end UiPath solutions: REFramework,<br />
              API integrations, Orchestrator governance.
            </div>

            <div class="terminal-line">
              <span class="prompt">$</span>
              <span class="cursor-blink">█</span>
            </div>
          </div>
        </div>

        <div class="hero-actions">
          <a href="/projects" class="btn btn-primary">$ ls ./projects</a>
          <a href="/blog" class="btn btn-secondary">$ cat blog/*</a>
        </div>
      </div>

      <div class="hero-visual animate-float">
        <div class="hero-card glass">
          <div class="hero-photo">
            <img src="/images/profile.jpg" alt="Bogdan Stoica" />
          </div>
          <div class="hero-card-header">
            <span class="status-dot"></span>
            <span class="status-text">[ONLINE] Ready for opportunities</span>
          </div>
          <div class="hero-stats">
            <div class="stat">
              <span class="stat-value">2.6+</span>
              <span class="stat-label">years_exp</span>
            </div>
            <div class="stat">
              <span class="stat-value">4+</span>
              <span class="stat-label">automations</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section - Terminal Style -->
  <section class="section skills-section">
    <div class="container">
      <div class="section-header terminal-header-section">
        <h2><span class="prompt-header">$</span> cat skills.log</h2>
        <p class="terminal-comment"># Core competencies I work with daily</p>
      </div>

      <div class="skills-grid">
        {
          skills.map((skill, index) => (
            <div class={`skill-item stagger-${index + 1}`}>
              <SkillBar name={skill.name} level={skill.level} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Experience Timeline -->
  <section class="section experience-section">
    <div class="container">
      <div class="section-header terminal-header-section">
        <h2><span class="prompt-header">$</span> git log --experience</h2>
        <p class="terminal-comment"># My professional journey</p>
      </div>

      <Timeline />
    </div>
  </section>

  <!-- CV Content Sections -->
  <section class="section cv-sections">
    <div class="container">
      {
        sortedSections.map(async (section) => {
          const { Content } = await section.render();
          return (
            <div class="cv-section card animate-fade-in-up">
              <div class="cv-section-content prose">
                <Content />
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- CTA Section - Terminal Style -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-terminal">
          <div class="cta-line">
            <span class="prompt">$</span>
            <span class="command">echo</span> "Let's collaborate!"
          </div>
          <div class="cta-output">
            &gt; I'm always open to new projects and interesting collaborations.
          </div>
        </div>
        <div class="cta-buttons">
          <a href="mailto:bogdan10andrei@gmail.com" class="btn btn-primary">
            $ mail --send
          </a>
          <a href="/Resume.pdf" download class="btn btn-secondary">
            $ wget resume.pdf
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero - Terminal Style */
  .hero {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    padding: var(--space-16) 0;
  }

  .hero .container {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  /* Terminal Window */
  .terminal-window {
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 0 40px rgba(0, 255, 65, 0.1);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: rgba(0, 0, 0, 0.4);
    border-bottom: 1px solid var(--color-border);
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .terminal-dot.red {
    background: #ff5f56;
  }
  .terminal-dot.yellow {
    background: #ffbd2e;
  }
  .terminal-dot.green {
    background: #27c93f;
  }

  .terminal-title {
    margin-left: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .terminal-body {
    padding: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  .terminal-line {
    margin-bottom: var(--space-2);
  }

  .prompt {
    color: var(--color-primary);
    font-weight: bold;
  }

  .command {
    color: var(--color-accent);
  }

  .terminal-output {
    color: var(--color-text-secondary);
    padding-left: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .name-output {
    color: var(--color-primary);
    font-size: var(--text-2xl);
    font-weight: bold;
    text-shadow: 0 0 20px rgba(0, 255, 65, 0.4);
  }

  .title-output {
    color: var(--color-accent);
    font-size: var(--text-xl);
  }

  .desc-output {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .cursor-blink {
    color: var(--color-primary);
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }

  .hero-actions .btn {
    font-family: var(--font-mono);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .hero-card {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    min-width: 280px;
    text-align: center;
    border: 1px solid var(--color-border);
    background: rgba(0, 255, 65, 0.02);
  }

  .hero-photo {
    width: 150px;
    height: 150px;
    margin: 0 auto var(--space-6);
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--color-primary);
    box-shadow: 0 0 30px rgba(0, 255, 65, 0.3);
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.8) contrast(1.1);
  }

  .hero-card-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: var(--color-primary);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
    box-shadow: 0 0 10px var(--color-primary);
  }

  .status-text {
    color: var(--color-primary);
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 10px var(--color-primary);
    }
    50% {
      opacity: 0.7;
      box-shadow: 0 0 20px var(--color-primary);
    }
  }

  .hero-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .stat {
    text-align: center;
  }

  .stat-value {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--color-primary);
    text-shadow: 0 0 20px rgba(0, 255, 65, 0.4);
  }

  .stat-label {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  /* Sections */
  .section {
    padding: var(--space-20) 0;
  }

  /* Terminal Section Headers */
  .terminal-header-section h2 {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .prompt-header {
    color: var(--color-primary);
    font-weight: bold;
  }

  .terminal-comment {
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-top: var(--space-2);
  }

  /* Skills */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: var(--space-4);
  }

  .skill-item {
    opacity: 0;
    animation: fadeInUp 0.5s ease forwards;
  }

  .skill-item {
    opacity: 0;
    animation: fadeInUp 0.5s ease forwards;
  }

  /* CV Sections */
  .cv-sections .container {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .cv-section {
    display: flex;
    gap: var(--space-6);
  }

  .cv-section-content {
    flex: 1;
  }

  /* Prose styles for MDX content */
  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3) {
    margin-top: var(--space-6);
    margin-bottom: var(--space-4);
  }

  .prose :global(h1:first-child),
  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    margin-bottom: var(--space-4);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
    color: var(--color-text-secondary);
  }

  .prose :global(hr) {
    border: none;
    height: 1px;
    background: var(--color-border);
    margin: var(--space-8) 0;
  }

  .prose :global(strong) {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* CTA */
  .cta-card {
    text-align: center;
    padding: var(--space-16);
    border-radius: var(--radius-2xl);
  }

  .cta-card h2 {
    margin-bottom: var(--space-4);
  }

  .cta-card p {
    margin-bottom: var(--space-8);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero .container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-title {
      font-size: var(--text-4xl);
    }

    .hero-subtitle {
      font-size: var(--text-2xl);
    }

    .hero-description {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .cv-section {
      flex-direction: column;
    }
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/projects/ProjectCard.astro";
import { getCollection } from "astro:content";

const featuredProjects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => b.data.completedDate.valueOf() - a.data.completedDate.valueOf())
  .slice(0, 4);

const engagementFit = [
  {
    id: "01",
    label: "Azure / DevOps",
    title: "Cloud implementation contractor",
    description:
      "I can set up and operate Azure infrastructure, Container Apps, Key Vault configuration, CI/CD pipelines and release flows for small engineering teams.",
    proof: "Current production focus at Automatify.",
  },
  {
    id: "02",
    label: "REST / OAuth / UiPath",
    title: "Integration & automation engineer",
    description:
      "I build integration-heavy systems with OAuth, pagination, rate-limit handling, queue retries, correlation IDs and production support discipline.",
    proof: "4 enterprise systems delivered as solo developer.",
  },
  {
    id: "03",
    label: "Next.js / React Native",
    title: "Product engineer",
    description:
      "I can move between web, mobile and backend workflows, shaping ambiguous product requirements into shipped interfaces and service boundaries.",
    proof: "React Native/Expo mobile work plus full-stack product experiments.",
  },
  {
    id: "04",
    label: "Foundry / MCP / LLM APIs",
    title: "AI workflow systems builder",
    description:
      "I integrate LLMs into useful internal tooling by wrapping model calls with validation, retries, structured outputs and operational visibility.",
    proof: "Microsoft Foundry, MCP integrations and AI code review tooling.",
  },
];

const proofPoints = [
  {
    value: "4",
    label: "enterprise systems shipped",
    detail: "Delivered end-to-end as solo developer, from requirements to production support.",
  },
  {
    value: "Dev/UAT/Prod",
    label: "release governance",
    detail: "Package versioning, CI/CD release promotion and production-safe environment separation.",
  },
  {
    value: "OAuth + queues",
    label: "integration reliability",
    detail: "Rate limits, pagination, retries/backoff, correlation IDs and audit-friendly logs.",
  },
  {
    value: "C1+",
    label: "client communication",
    detail: "Near-native English for explaining technical decisions to non-technical stakeholders.",
  },
];

const capabilities = [
  {
    id: "01",
    label: "architecture to deployment",
    title: "Full lifecycle ownership",
    description:
      "I am strongest in roles where one person needs to understand requirements, design the solution, implement it, release it and support it after production launch.",
  },
  {
    id: "02",
    label: "production integrations",
    title: "Reliability-first integrations",
    description:
      "REST/OAuth integrations with explicit failure modes, retry boundaries, idempotency, structured logging and environment-specific credentials.",
  },
  {
    id: "03",
    label: "cloud and product",
    title: "Cloud-backed product delivery",
    description:
      "Azure infrastructure, DevOps pipelines, React Native mobile apps, Next.js interfaces and backend workflows designed around practical delivery constraints.",
  },
  {
    id: "04",
    label: "ai workflows",
    title: "Useful AI, not demos",
    description:
      "LLM/API integrations are treated as systems: schemas, validations, observability, user workflows and safe fallback behavior before visual novelty.",
  },
];

const experience = [
  {
    role: "Software Engineer",
    company: "Automatify",
    period: "Mar 2026 — Present",
    location: "Cluj-Napoca · Hybrid",
    current: true,
    points: [
      "Architect, develop and manage Azure infrastructure using Container Apps, Key Vault and Azure DevOps pipelines.",
      "Develop cross-platform mobile applications using React Native and Expo.",
      "Build AI-powered workflow solutions using Microsoft Foundry and Model Context Protocol integrations.",
    ],
  },
  {
    role: "RPA Developer / Automation & Integration Engineer",
    company: "Tquila Automation",
    period: "Jul 2023 — Mar 2026",
    location: "Romania · Remote",
    current: false,
    points: [
      "Delivered 4 enterprise UiPath automations end-to-end as solo developer, from requirements and architecture through release and support.",
      "Integrated REST APIs with OAuth, pagination, rate limiting, retries/backoff and structured telemetry for production reliability.",
      "Managed UiPath Orchestrator queues, assets, credentials, triggers, schedules, folders and Dev/UAT/Prod CI/CD governance.",
      "Standardized REFramework with idempotency, error taxonomy, correlation IDs and audit-friendly logs.",
    ],
  },
];

const stackGroups = [
  {
    label: "Cloud & DevOps",
    items: ["Azure", "Container Apps", "Key Vault", "Azure DevOps", "Docker", "CI/CD"],
  },
  {
    label: "Product Stack",
    items: ["Next.js", "TypeScript", "React Native", "Expo", "React", "SQL"],
  },
  {
    label: "Integrations & Automation",
    items: ["REST APIs", "OAuth", "UiPath", "Orchestrator", "REFramework", "Structured Logs"],
  },
  {
    label: "AI & Systems Track",
    items: ["Microsoft Foundry", "MCP", "LLM APIs", "Go", "Rust", "WebAssembly"],
  },
];

const sharpening = [
  {
    title: "Go backend systems",
    evidence: "Boot.dev Go + HTTP Clients certifications; private Go microservices in Viver.",
    items: ["HTTP clients", "service boundaries", "testing", "observability"],
  },
  {
    title: "Rust and WebAssembly",
    evidence: "Public Rust Cloud Terminal, CLI utilities and lower-level systems experiments.",
    items: ["Axum", "Yew", "WASM", "memory-safe systems"],
  },
  {
    title: "Operational AI workflows",
    evidence: "AI code review server, Microsoft Foundry work and MCP integration path.",
    items: ["structured outputs", "validation", "metrics", "tool integration"],
  },
];
---

<BaseLayout
  title="Bogdan Stoica — Software Engineer"
  description="Software Engineer in Cluj-Napoca building Azure cloud infrastructure, integration-heavy systems, React Native products and reliable AI workflow tooling."
>
  <!-- ===== HERO ===== -->
  <section class="hero section" id="hero">
    <div class="container hero-grid">
      <div class="hero-content animate-fade-in-up">
        <span class="technical-label">Software Engineer · Azure · Integrations · Product</span>
        <h1>I build integration-heavy cloud products from architecture to production.</h1>
        <p class="hero-lead">
          Based in Cluj-Napoca, I help teams ship systems that need more than UI polish:
          Azure infrastructure, deployment pipelines, REST/OAuth integrations, React Native products and AI workflow tooling that can be operated in production.
        </p>

        <div class="hero-actions">
          <a href="mailto:bogdan10andrei@gmail.com?subject=Intro%20call%20-%20software%20engineering%20opportunity" class="btn btn-primary">
            book intro call
          </a>
          <a href="/cv" class="btn btn-secondary">view cv</a>
          <a href="/projects" class="btn btn-secondary">project evidence</a>
        </div>

        <div class="hero-credentials" aria-label="Profile highlights">
          <span class="cred-item">Open to B2B / contract / full-time</span>
          <span class="cred-sep">·</span>
          <span class="cred-item">4 enterprise systems shipped</span>
          <span class="cred-sep">·</span>
          <span class="cred-item">English C1 near-native</span>
        </div>
      </div>

      <div class="hero-visual animate-fade-in-up stagger-1">
        <div class="dossier-card card">
          <div class="dossier-photo-container">
            <img src="/images/profile.jpg" alt="Bogdan Stoica" class="dossier-photo" />
          </div>
          <div class="dossier-meta">
            <div class="meta-row">
              <span class="meta-label">ENGAGEMENT</span>
              <span class="meta-value text-accent">OPEN TO OPPORTUNITIES</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">ROLE</span>
              <span class="meta-value">SOFTWARE ENGINEER</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">BEST FIT</span>
              <span class="meta-value">CLOUD / INTEGRATIONS / AI</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">LOCATION</span>
              <span class="meta-value">CLUJ-NAPOCA, RO</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">EDUCATION</span>
              <span class="meta-value">MSC COMPUTER SCIENCE</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== HIRE ME FOR ===== -->
  <section class="section" id="hire-me-for">
    <div class="container">
      <span class="technical-label">Hire me for</span>
      <div class="section-heading-row">
        <h2 class="section-title">Clear fit for contract, B2B and engineering team roles.</h2>
        <p class="section-intro compact">
          The fastest way to evaluate me: these are the problems where my experience maps directly to business value.
        </p>
      </div>

      <div class="engagement-grid">
        {
          engagementFit.map((item) => (
            <article class="engagement-card card">
              <div class="cap-header">
                <span class="cap-id">{item.id}.</span>
                <span class="cap-label">{item.label}</span>
              </div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <div class="proof-chip">{item.proof}</div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== PROOF STRIP ===== -->
  <section class="section proof-section" id="proof">
    <div class="container">
      <span class="technical-label">Proof points</span>
      <h2 class="section-title">Operational maturity, not just implementation speed.</h2>

      <div class="proof-grid">
        {
          proofPoints.map((item) => (
            <div class="proof-card card">
              <strong>{item.value}</strong>
              <span>{item.label}</span>
              <p>{item.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== CAPABILITIES ===== -->
  <section class="section" id="capabilities">
    <div class="container">
      <span class="technical-label">Capabilities</span>
      <h2 class="section-title">Systems that bridge product, cloud and operations.</h2>
      <p class="section-intro">
        I operate best when the work requires engineering judgment across architecture, setup, implementation, release flow and long-term production behavior.
      </p>

      <div class="capabilities-grid">
        {
          capabilities.map((item) => (
            <div class="capability-card card">
              <div class="cap-header">
                <span class="cap-id">{item.id}.</span>
                <span class="cap-label">{item.label}</span>
              </div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== EXPERIENCE ===== -->
  <section class="section" id="experience">
    <div class="container">
      <span class="technical-label">Experience</span>
      <h2 class="section-title">Recent roles and delivery evidence.</h2>

      <div class="timeline-container">
        <div class="timeline-line"></div>
        <div class="timeline-list">
          {
            experience.map((item) => (
              <div class="timeline-item">
                <div class="timeline-marker">
                  <div class="marker-dot"></div>
                </div>
                <div class="timeline-card-wrapper">
                  <div class="timeline-entry card">
                    <div class="timeline-meta">
                      <span class="timeline-period">{item.period}</span>
                      {item.current && <span class="timeline-current">Active</span>}
                    </div>
                    <div class="timeline-content">
                      <h3>{item.role}</h3>
                      <p class="timeline-company">{item.company} · <span class="loc">{item.location}</span></p>
                      <ul class="timeline-points">
                        {item.points.map((point) => (
                          <li>{point}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ===== STACK ===== -->
  <section class="section" id="stack">
    <div class="container">
      <span class="technical-label">Technical Stack</span>
      <h2 class="section-title">Technical environment.</h2>

      <div class="stack-grid">
        {
          stackGroups.map((group) => (
            <div class="stack-card card">
              <div class="stack-card-header">
                <span class="stack-label-text">{group.label}</span>
              </div>
              <div class="stack-chips">
                {group.items.map((item) => (
                  <span class="tag">{item}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== CURRENT TECHNICAL DEEPENING ===== -->
  <section class="section" id="sharpening">
    <div class="container">
      <span class="technical-label">Current technical deepening</span>
      <h2 class="section-title">Evidence-based learning track.</h2>
      <p class="section-intro">
        Instead of percentage-based self-ratings, I prefer to show what I am building and studying publicly.
      </p>
      
      <div class="sharpening-grid">
        {
          sharpening.map((item) => (
            <article class="sharpening-card card">
              <h3>{item.title}</h3>
              <p>{item.evidence}</p>
              <div class="sharpening-tags">
                {item.items.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== PROJECTS ===== -->
  <section class="section" id="projects">
    <div class="container">
      <span class="technical-label">Selected Work</span>
      <h2 class="section-title">Project evidence and anonymized case studies.</h2>
      <p class="section-intro">
        Selected work showing integration reliability, product engineering, cloud-backed systems and AI workflow tooling.
      </p>

      <div class="homepage-projects-grid">
        {
          featuredProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              technologies={project.data.technologies}
              slug={project.id}
              githubUrl={project.data.githubUrl}
              liveUrl={project.data.liveUrl}
              coverImage={project.data.coverImage}
              outcome={project.data.outcome}
              featured={project.data.featured}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== EDUCATION ===== -->
  <section class="section" id="education">
    <div class="container education-grid">
      <div>
        <span class="technical-label">Education</span>
        <h2 class="section-title">Academic history and technical foundation.</h2>
      </div>
      <div class="education-card card">
        <div class="edu-item">
          <div class="edu-header">
            <h3>Master's Degree in Computer Science</h3>
            <span class="edu-date">2025 — 2027</span>
          </div>
          <p class="edu-meta">Babeș-Bolyai University, Cluj-Napoca, Romania</p>
          <p class="edu-desc">Focus on systems design, practical software engineering, Go and distributed systems.</p>
        </div>
        
        <div class="edu-divider"></div>

        <div class="edu-item">
          <div class="edu-header">
            <h3>Bachelor's Degree in Computer Science</h3>
            <span class="edu-date">2022 — 2025</span>
          </div>
          <p class="edu-meta">Babeș-Bolyai University, Cluj-Napoca, Romania</p>
          <p class="edu-desc">Core coursework in algorithms, operating systems, databases and software design.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CONTACT ===== -->
  <section class="section" id="contact">
    <div class="container">
      <div class="contact-block card">
        <span class="technical-label">Contact</span>
        <h2>Need someone to own a cloud setup, integration workflow or product build?</h2>
        <p>
          I am open to contract engagements, B2B consulting, cloud architecture setups, internal workflow tooling and full-time software engineering roles. References available on request.
        </p>
        <div class="contact-actions">
          <a href="mailto:bogdan10andrei@gmail.com?subject=Software%20engineering%20opportunity" class="btn btn-primary">
            book intro call
          </a>
          <a href="/cv" class="btn btn-secondary">view cv</a>
          <a
            href="https://www.linkedin.com/in/bogdan-stoica-aa415820a/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            linkedin profile
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== HERO ===== */

  .hero {
    padding-top: clamp(100px, 12vw, 150px);
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .hero-content h1 {
    margin-bottom: 20px;
    font-size: var(--text-5xl);
  }

  .hero-lead {
    max-width: 660px;
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: var(--color-text-secondary);
    margin-bottom: 32px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 40px;
  }

  .hero-credentials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
  }

  .cred-sep {
    color: var(--color-accent);
  }

  .dossier-card {
    padding: 16px;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    max-width: 380px;
    margin: 0 auto;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .dossier-photo-container {
    width: 100%;
    aspect-ratio: 1.1 / 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(56, 189, 248, 0.15);
    margin-bottom: 16px;
    background: #0d111b;
  }

  .dossier-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: saturate(0.85) contrast(1.05);
  }

  .dossier-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 6px;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.04);
  }

  .meta-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .meta-label {
    color: var(--color-text-muted);
  }

  .meta-value {
    color: var(--color-text);
    font-weight: 500;
    text-align: right;
  }

  /* ===== SECTION UTILITIES ===== */

  .section-title {
    margin-bottom: 16px;
    max-width: 820px;
  }

  .section-intro {
    max-width: 700px;
    margin-bottom: 48px;
  }

  .section-intro.compact {
    margin-bottom: 0;
  }

  .section-heading-row {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 32px;
    align-items: end;
    margin-bottom: 48px;
  }

  /* ===== HIRE ME FOR ===== */

  .engagement-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .engagement-card {
    padding: 24px;
    display: flex;
    flex-direction: column;
    min-height: 300px;
  }

  .engagement-card h3 {
    margin-bottom: 12px;
    font-size: 17px;
  }

  .engagement-card p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .proof-chip {
    margin-top: auto;
    padding-top: 18px;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
  }

  /* ===== PROOF ===== */

  .proof-section {
    padding-top: clamp(44px, 6vw, 70px);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 32px;
  }

  .proof-card {
    padding: 22px;
  }

  .proof-card strong {
    display: block;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 18px;
    margin-bottom: 8px;
  }

  .proof-card span {
    display: block;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }

  .proof-card p {
    color: var(--color-text-secondary);
    font-size: 13px;
    line-height: 1.55;
  }

  /* ===== CAPABILITIES ===== */

  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .capability-card {
    padding: 28px;
  }

  .cap-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    margin-bottom: 20px;
  }

  .cap-id {
    color: var(--color-accent);
    font-weight: 600;
  }

  .cap-label {
    color: var(--color-text-muted);
    text-align: right;
  }

  .capability-card h3 {
    margin-bottom: 12px;
    font-size: 18px;
  }

  .capability-card p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* ===== TIMELINE / EXPERIENCE ===== */

  .timeline-container {
    position: relative;
    max-width: 860px;
    margin: 40px 0 0 10px;
  }

  .timeline-line {
    position: absolute;
    left: 10px;
    top: 0;
    bottom: 0;
    width: 1px;
    background-image: linear-gradient(to bottom, var(--color-accent) 0%, rgba(56, 189, 248, 0.05) 100%);
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .timeline-item {
    display: flex;
    gap: 24px;
    position: relative;
  }

  .timeline-marker {
    width: 21px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 24px;
  }

  .marker-dot {
    width: 9px;
    height: 9px;
    background: var(--color-bg);
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    z-index: 2;
    box-shadow: 0 0 6px var(--color-accent);
  }

  .timeline-card-wrapper {
    flex: 1;
  }

  .timeline-entry {
    padding: 24px;
  }

  .timeline-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .timeline-period {
    color: var(--color-text-muted);
  }

  .timeline-current {
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    padding: 1px 6px;
    border-radius: 2px;
    font-size: 10px;
    text-transform: uppercase;
    font-weight: 600;
  }

  .timeline-content h3 {
    font-size: 18px;
    margin-bottom: 4px;
  }

  .timeline-company {
    color: var(--color-text-secondary);
    font-weight: 600;
    font-size: 13px;
    margin-bottom: 16px;
  }

  .timeline-company .loc {
    color: var(--color-text-muted);
    font-weight: 400;
    font-size: 12px;
  }

  .timeline-points {
    padding-left: 14px;
    display: grid;
    gap: 10px;
  }

  .timeline-points li {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  /* ===== STACK ===== */

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

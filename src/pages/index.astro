---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import Timeline from "../components/cv/Timeline.astro";
import SkillBar from "../components/cv/SkillBar.astro";

const cvSections = await getCollection("cv");
const sortedSections = cvSections.sort((a, b) => a.data.order - b.data.order);

// Skills based on LinkedIn profile
const skills = [
  { name: "UiPath", level: 95, category: "RPA" },
  { name: "REFramework", level: 90, category: "RPA" },
  { name: "Model Context Protocol", level: 35, category: "RPA" },
  { name: "REST APIs", level: 99, category: "Development" },
  { name: "React", level: 50, category: "Development" },
  { name: "React Native", level: 45, category: "Development" },
  { name: "C#", level: 30, category: "Development" },
  { name: "Java", level: 30, category: "Development" },
  { name: "TypeScript", level: 65, category: "Development" },
];
---

<BaseLayout
  title="Bogdan Stoica - UiPath RPA Engineer"
  description="Automation engineer with 2.6+ years delivering end-to-end UiPath solutions"
>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-content animate-fade-in-up">
        <div class="hero-badge tag">Welcome to my portfolio</div>
        <h1 class="hero-title">
          I'm <span class="highlight">Bogdan Stoica</span>,<br />
          <span class="hero-subtitle">UiPath RPA Engineer</span>
        </h1>
        <p class="hero-description">
          Automation engineer with 2.6+ years delivering end-to-end UiPath
          solutions: REFramework implementation, API integrations, Orchestrator
          governance.
        </p>
        <div class="hero-actions">
          <a href="/projects" class="btn btn-primary"> View Projects </a>
          <a href="/blog" class="btn btn-secondary"> Read Blog </a>
        </div>
      </div>

      <div class="hero-visual animate-float">
        <div class="hero-card glass">
          <div class="hero-photo">
            <img src="/images/profile.jpg" alt="Bogdan Stoica" />
          </div>
          <div class="hero-card-header">
            <span class="status-dot"></span>
            <span>Open to opportunities</span>
          </div>
          <div class="hero-stats">
            <div class="stat">
              <span class="stat-value">2.6+</span>
              <span class="stat-label">Years Experience</span>
            </div>
            <div class="stat">
              <span class="stat-value">4+</span>
              <span class="stat-label">Enterprise Automations</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="section skills-section">
    <div class="container">
      <div class="section-header">
        <h2>Skills and Technologies</h2>
        <p>Core competencies I work with daily</p>
      </div>

      <div class="skills-grid">
        {
          skills.map((skill, index) => (
            <div class={`skill-item stagger-${index + 1}`}>
              <SkillBar name={skill.name} level={skill.level} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Experience Timeline -->
  <section class="section experience-section">
    <div class="container">
      <div class="section-header">
        <h2>Experience</h2>
        <p>My professional journey</p>
      </div>

      <Timeline />
    </div>
  </section>

  <!-- CV Content Sections -->
  <section class="section cv-sections">
    <div class="container">
      {
        sortedSections.map(async (section) => {
          const { Content } = await section.render();
          return (
            <div class="cv-section card animate-fade-in-up">
              <div class="cv-section-content prose">
                <Content />
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-card glass">
        <h2>Let's work together</h2>
        <p>I'm always open to new projects and interesting collaborations.</p>
        <div class="cta-buttons">
          <a href="mailto:bogdan10andrei@gmail.com" class="btn btn-primary">
            Contact Me
          </a>
          <a href="/Resume.pdf" download class="btn btn-secondary">
            Download CV
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    padding: var(--space-16) 0;
  }

  .hero .container {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hero-badge {
    margin-bottom: var(--space-6);
  }

  .hero-title {
    font-size: var(--text-6xl);
    margin-bottom: var(--space-6);
    line-height: 1.1;
  }

  .hero-subtitle {
    font-weight: 400;
    color: var(--color-text-secondary);
    font-size: var(--text-4xl);
  }

  .hero-description {
    font-size: var(--text-lg);
    max-width: 500px;
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .hero-card {
    padding: var(--space-8);
    border-radius: var(--radius-2xl);
    min-width: 280px;
    text-align: center;
  }

  .hero-photo {
    width: 150px;
    height: 150px;
    margin: 0 auto var(--space-6);
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--color-primary);
    box-shadow: var(--shadow-glow);
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-card-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .stat {
    text-align: center;
  }

  .stat-value {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 800;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .stat-label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Sections */
  .section {
    padding: var(--space-20) 0;
  }

  /* Skills */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  .skill-item {
    opacity: 0;
    animation: fadeInUp 0.5s ease forwards;
  }

  /* CV Sections */
  .cv-sections .container {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .cv-section {
    display: flex;
    gap: var(--space-6);
  }

  .cv-section-content {
    flex: 1;
  }

  /* Prose styles for MDX content */
  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3) {
    margin-top: var(--space-6);
    margin-bottom: var(--space-4);
  }

  .prose :global(h1:first-child),
  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    margin-bottom: var(--space-4);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
    color: var(--color-text-secondary);
  }

  .prose :global(hr) {
    border: none;
    height: 1px;
    background: var(--color-border);
    margin: var(--space-8) 0;
  }

  .prose :global(strong) {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* CTA */
  .cta-card {
    text-align: center;
    padding: var(--space-16);
    border-radius: var(--radius-2xl);
  }

  .cta-card h2 {
    margin-bottom: var(--space-4);
  }

  .cta-card p {
    margin-bottom: var(--space-8);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero .container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-title {
      font-size: var(--text-4xl);
    }

    .hero-subtitle {
      font-size: var(--text-2xl);
    }

    .hero-description {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .cv-section {
      flex-direction: column;
    }
  }
</style>

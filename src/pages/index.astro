---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroScan from "../components/home/HeroScan.astro";
import PostVisual from "../components/blog/PostVisual.astro";
import { getCollection } from "astro:content";
import { getVisiblePosts, postCategory } from "../lib/posts";

const contactHref = "mailto:bogdan10andrei@gmail.com?subject=Hello%20Bogdan";

// The statement that lights up word by word as it scrolls through the viewport.
const statement =
  "I build software the way I'd want it built for me: carefully, end to end, and made to last. Curious by default, from driving a competition robot to running AI systems in production.";
const statementWords = statement.split(" ");

const values = [
  {
    title: "One owner, end to end.",
    text: "Requirements, architecture, code, release, support. I've shipped production systems as the only engineer on them, so I design for the person who gets paged. That person is me.",
    size: "wide",
  },
  {
    title: "Boring in production.",
    text: "Retries, idempotency, structured logs. The exciting part should be what the system does, never how it fails.",
    size: "narrow",
  },
  {
    title: "Clear with everyone.",
    text: "Three years client-facing, in English, explaining technical decisions to people who aren't technical. What clients praised was the clarity.",
    size: "narrow",
  },
  {
    title: "Still a student.",
    text: "A Master's at Babeș-Bolyai, Go certifications on the side, Rust for fun. I'd rather learn the layer underneath than trust it blindly.",
    size: "wide",
  },
];

// Client names stay private: describe the system and my role, never the customer.
const nowBuilding = [
  {
    title: "A Vendor Invoice Manager, with AI as the decision-maker",
    text: "Invoices arrive by email. A model reads them, decides which rule applies and who approves, and the result is booked in Dynamics 365. I'm building all of it.",
  },
  {
    title: "Contract archiving and a digital point of sale",
    text: "For a retail client: scanned contracts are read, matched and archived on the Dynamics side without anyone retyping them.",
  },
];

const journey = [
  {
    year: "2021",
    title: "Driving the robot",
    text: "Main driver for my FIRST Tech Challenge team at the national phase. We came home with the Collins Aerospace Innovate Award.",
  },
  {
    year: "2022",
    title: "Olympiad, then university",
    text: "Second place in the county phase of the National Olympiad in Informatics. Started Computer Science at Babeș-Bolyai and spent a year organising student events with OSUBB.",
  },
  {
    year: "2023",
    title: "First production systems",
    text: "Joined Tquila Automation as an intern in July and stayed as an RPA Developer. Over the next years: four enterprise automations, delivered as the solo developer.",
  },
  {
    year: "2025",
    title: "One degree done, one started",
    text: "Finished my Bachelor's and went straight into a Master's in Computer Science: systems design, Go and distributed systems.",
  },
  {
    year: "2026",
    title: "Software Engineer at Automatify",
    text: "AI document automation, a contract platform in production, a mobile app in both stores, and the Azure infrastructure under all of it.",
    current: true,
  },
];

const work = (await getCollection("projects"))
  .filter((project) => project.data.homeOrder !== undefined)
  .sort((a, b) => a.data.homeOrder! - b.data.homeOrder!);

const posts = await getVisiblePosts();
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const morePosts = posts.filter((post) => post !== featuredPost).slice(0, 4);
---

<BaseLayout
  title="Bogdan Stoica — Software Engineer"
  description="I'm Bogdan, a software engineer in Cluj-Napoca. I design, build and run production systems end to end: AI document automation, Next.js platforms, mobile apps and the Azure infrastructure under them."
>
  <!-- ===== HERO: the person first ===== -->
  <section class="hero" id="hero">
    <div class="container">
      <div class="hero-text">
        <h1 data-split class="hero-title">Hi, I'm Bogdan.</h1>
        <p class="hero-lead animate-fade-in-up stagger-1">
          A software engineer in Cluj-Napoca. I design, build and run production systems on my own, end to end.
        </p>
        <div class="hero-actions animate-fade-in-up stagger-2">
          <a href={contactHref} class="btn btn-primary" data-magnetic>Get in touch</a>
          <a href="/cv" class="text-link">Read my CV</a>
        </div>
      </div>

      <div class="intro-grid">
        <figure class="intro-photo intro-in" style="--d:0;">
          <img src="/images/profile.jpg" alt="Portrait of Bogdan Stoica" width="684" height="654" />
        </figure>

        <div class="card intro-tile intro-what intro-in" data-tilt style="--d:1;">
          <h2>I take a problem from a whiteboard to something that runs every day.</h2>
          <p>
            Architecture, code, the cloud it runs on, the pipeline that ships it, and what happens at 3 a.m. when an
            API it depends on goes down.
          </p>
        </div>

        <div class="card intro-tile intro-now intro-in" data-tilt style="--d:2;">
          <span class="intro-status"><span class="live-dot"></span>Open to new work</span>
          <p class="intro-fact">Software Engineer at Automatify</p>
          <p class="intro-sub">B2B, contract or full-time</p>
        </div>

        <div class="card intro-tile intro-where intro-in" data-tilt style="--d:3;">
          <p class="intro-fact">Cluj-Napoca, Romania</p>
          <p class="intro-sub">English, professional · Romanian, native</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ABOUT: a statement that reads itself as you scroll ===== -->
  <section class="section about" id="about">
    <div class="container">
      <p class="statement" id="statement" style={`--n:${statementWords.length};`}>
        {
          statementWords.map((word, i) => (
            <span class="statement-word" style={`--i:${i};`}>{word} </span>
          ))
        }
      </p>
    </div>
  </section>

  <!-- ===== HOW I WORK ===== -->
  <section class="section section-tinted" id="how">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="technical-label">How I work</span>
        <h2 data-split>What you get when you work with me.</h2>
      </div>

      <div class="values-grid">
        {
          values.map((value, i) => (
            <article class:list={["card", "value-tile", `value-${value.size}`]} data-reveal data-tilt style={`--reveal-delay:${(i % 2) * 90}ms;`}>
              <h3>{value.title}</h3>
              <p>{value.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== NOW ===== -->
  <section class="section" id="now">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="technical-label">On my desk</span>
        <h2 data-split>What I'm building right now.</h2>
      </div>

      <div class="now-grid">
        <div class="now-list">
          {
            nowBuilding.map((item, i) => (
              <article class="now-item" data-reveal style={`--reveal-delay:${i * 100}ms;`}>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
          <p class="now-note" data-reveal>Both are mine from architecture to deployment. Client names stay private.</p>
        </div>

        <div class="now-demo" data-scale-in>
          <HeroScan />
          <p class="now-caption">What the invoice pipeline does, on a loop: read, extract, check, book.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== JOURNEY ===== -->
  <section class="section section-tinted" id="journey">
    <div class="container">
      <div class="section-head journey-head" data-reveal>
        <div>
          <span class="technical-label">How I got here</span>
          <h2 data-split>From driving a robot to running production.</h2>
        </div>
        <div class="journey-controls">
          <button type="button" class="journey-btn" id="journey-prev" aria-label="Earlier">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
          </button>
          <button type="button" class="journey-btn" id="journey-next" aria-label="Later">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
          </button>
        </div>
      </div>
    </div>

    <ol class="journey-track" id="journey-track" tabindex="0" aria-label="Timeline, scroll sideways">
      {
        journey.map((step) => (
          <li class:list={["journey-card", { "journey-card-current": step.current }]}>
            <span class="journey-year">{step.year}{step.current && <span class="live-dot" />}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ===== WORK ===== -->
  <section class="section" id="work">
    <div class="container">
      <div class="section-head section-head-row" data-reveal>
        <div>
          <span class="technical-label">Selected work</span>
          <h2 data-split>Shipped, and still running.</h2>
        </div>
        <a href="/projects" class="text-link">All case studies</a>
      </div>

      <div class="row-list" data-reveal>
        {
          work.map((project) => (
            <a class="row work-row" href={`/projects/${project.id}`}>
              <span class="row-title work-title" transition:name={`project-${project.id}`}>{project.data.title}</span>
              <span class="row-desc">{project.data.description}</span>
              <svg class="row-arrow" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== WRITING ===== -->
  {
    featuredPost && (
      <section class="section section-tinted" id="writing">
        <div class="container">
          <div class="section-head section-head-row" data-reveal>
            <div>
              <span class="technical-label">Writing</span>
              <h2 data-split>Things I learned the hard way.</h2>
            </div>
            <a href="/blog" class="text-link">All writing</a>
          </div>

          <div class:list={["writing-grid", { "writing-grid-single": morePosts.length === 0 }]}>
            <a class="featured-post card" href={`/blog/${featuredPost.id}`} data-reveal>
              {featuredPost.data.visual && (
                <div class="featured-visual"><PostVisual kind={featuredPost.data.visual} /></div>
              )}
              <div class="featured-body">
                <span class="featured-kicker">
                  {postCategory(featuredPost)}
                  {featuredPost.data.draft && <span class="draft-chip">Draft</span>}
                </span>
                <span class="featured-title" transition:name={`post-${featuredPost.id}`}>{featuredPost.data.title}</span>
                <span class="featured-desc">{featuredPost.data.description}</span>
              </div>
            </a>

            {
              morePosts.length > 0 && (
                <div class="row-list" data-reveal style="--reveal-delay:100ms;">
                  {morePosts.map((post) => (
                    <a class="row post-row" href={`/blog/${post.id}`}>
                      <span class="post-text">
                        <span class="row-kicker">
                          {postCategory(post)}
                          {post.data.draft && <span class="draft-chip">Draft</span>}
                        </span>
                        <span class="row-title post-title" transition:name={`post-${post.id}`}>{post.data.title}</span>
                      </span>
                      <svg class="row-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        </div>
      </section>
    )
  }

  <!-- ===== CONTACT ===== -->
  <section class="section contact-section" id="contact">
    <div class="container">
      <div class="contact" data-scale-in>
        <h2 data-split>Let's talk.</h2>
        <p>
          I'm open to B2B, contract and full-time work. Tell me what you're building, or what keeps breaking. References
          on request.
        </p>
        <div class="contact-actions">
          <a href={contactHref} class="btn btn-primary" data-magnetic>bogdan10andrei@gmail.com</a>
          <a href="https://www.linkedin.com/in/bogdan-stoica-aa415820a/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">LinkedIn</a>
          <a href="https://github.com/B0gsto" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">GitHub</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== HERO ===== */

  .hero {
    padding: clamp(56px, 9vw, 112px) 0 clamp(40px, 6vw, 72px);
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 820px;
    margin: 0 auto clamp(48px, 7vw, 80px);
    text-align: center;
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .hero-lead {
    max-width: 640px;
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--color-text-secondary);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px 28px;
    margin-top: 8px;
  }

  /* intro bento: the photo leads, three facts sit beside it */
  .intro-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto;
    gap: 20px;
  }

  /* the tile follows the photo's own proportions, so the framing is the photographer's, not the grid's */
  .intro-photo {
    grid-column: span 6;
    grid-row: span 2;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
  }

  .intro-photo img {
    width: 100%;
    height: 100%;
    aspect-ratio: 684 / 654;
    object-fit: cover;
    object-position: center top;
  }

  /* intro tiles materialise one after another on load */
  @keyframes introIn {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.96);
      filter: blur(12px);
    }
  }

  .intro-in {
    animation: introIn 1.1s var(--ease-out) backwards;
    animation-delay: calc(0.35s + var(--d) * 0.11s);
  }

  .intro-tile {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(24px, 3vw, 36px);
  }

  .intro-what {
    grid-column: span 6;
    gap: 16px;
    justify-content: center;
  }

  .intro-what h2 {
    font-size: clamp(1.6rem, 3vw, 2.375rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .intro-what p {
    max-width: 520px;
    font-size: var(--text-lg);
  }

  .intro-now {
    grid-column: span 3;
  }

  .intro-where {
    grid-column: span 3;
  }

  .intro-status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: auto;
    padding-bottom: 28px;
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .intro-fact {
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .intro-sub {
    margin-top: 6px;
    font-size: 15px;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  /* ===== ABOUT STATEMENT ===== */

  .about {
    padding-top: clamp(56px, 8vw, 104px);
  }

  .statement {
    max-width: 980px;
    margin: 0 auto;
    font-size: clamp(1.625rem, 3.6vw, 2.75rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: var(--color-text);
    text-wrap: pretty;
    /* without JS the whole statement is simply lit */
    --p: 1;
  }

  .statement-word {
    opacity: clamp(0.16, calc((var(--p) * (var(--n) + 6) - var(--i)) * 0.3 + 0.16), 1);
  }

  /* ===== SECTION HEADS ===== */

  .section-head {
    max-width: 760px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .journey-head > div:first-child {
    flex: 1 1 0;
    min-width: 0;
  }

  .section-head-row,
  .journey-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 16px 40px;
    max-width: none;
  }

  .journey-head {
    flex-wrap: nowrap;
  }

  /* ===== VALUES ===== */

  .values-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 20px;
  }

  .value-tile {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 260px;
    justify-content: flex-end;
    padding: clamp(24px, 3vw, 40px);
  }

  .value-wide {
    grid-column: span 7;
  }

  .value-narrow {
    grid-column: span 5;
  }

  .value-tile h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .value-tile p {
    max-width: 520px;
  }

  /* ===== NOW ===== */

  .now-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 40px 64px;
    align-items: center;
  }

  .now-list {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .now-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .now-item h3 {
    font-size: clamp(1.3rem, 2vw, 1.625rem);
    letter-spacing: -0.02em;
  }

  .now-note {
    font-size: 15px;
    color: var(--color-text-muted);
  }

  .now-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: clamp(20px, 3vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .now-caption {
    font-size: 14px;
    text-align: center;
    color: var(--color-text-muted);
  }

  /* ===== JOURNEY ===== */

  .journey-controls {
    display: flex;
    gap: 12px;
  }

  .journey-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.08);
    color: var(--color-text);
    cursor: pointer;
    transition: transform 120ms ease-out, background-color var(--transition-fast), opacity var(--transition-fast);
  }

  .journey-btn:hover {
    background: rgba(0, 0, 0, 0.14);
  }

  .journey-btn:active {
    transform: scale(0.94);
  }

  .journey-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .journey-track {
    --edge: max(var(--container-padding), calc((100vw - var(--container-max)) / 2 + var(--container-padding)));
    display: flex;
    gap: 20px;
    list-style: none;
    padding: 4px var(--edge) 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }

  .journey-track.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .journey-track::-webkit-scrollbar {
    display: none;
  }

  .journey-card {
    flex: 0 0 min(372px, 82vw);
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 320px;
    padding: 32px;
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    scroll-snap-align: start;
    transition: scale var(--transition-base);
  }

  .journey-track.is-dragging .journey-card {
    scale: 0.985;
  }

  .journey-card-current {
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.1), 0 2px 6px rgba(0, 0, 0, 0.05);
  }

  .journey-year {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: auto;
    padding-bottom: 40px;
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .journey-card h3 {
    font-size: var(--text-xl);
  }

  .journey-card p {
    font-size: 16px;
    line-height: 1.5;
  }

  /* ===== WORK ===== */

  .work-row {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) 28px;
  }

  .work-title {
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
  }

  /* ===== WRITING ===== */

  .writing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 40px 64px;
    align-items: start;
  }

  .writing-grid-single {
    grid-template-columns: minmax(0, 640px);
  }

  .featured-post {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 16px 16px 32px;
    color: var(--color-text);
    overflow: hidden;
  }

  .featured-post {
    transition: scale var(--transition-base);
  }

  .featured-post:hover {
    color: var(--color-text);
    scale: 1.012;
  }

  .featured-visual {
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .featured-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0 16px;
  }

  .featured-kicker,
  .row-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .featured-title {
    font-size: clamp(1.5rem, 2.4vw, 1.875rem);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .featured-desc {
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .post-row {
    grid-template-columns: minmax(0, 1fr) 24px;
    gap: 24px;
    padding: 22px 0;
  }

  .post-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .post-title {
    font-size: clamp(1.1rem, 1.6vw, 1.3125rem);
    letter-spacing: -0.015em;
    line-height: 1.25;

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
}).format(project.data.completedDate);
---

<BaseLayout title={`${project.data.title} - Projects`} description={project.data.description}>
  <article class="container project-page">
    <header class="project-header animate-fade-in-up">
      <a href="/projects" class="back-link">Back to projects</a>
      
      {project.data.featured && <span class="featured-badge tag">Featured Project</span>}
      
      <h1>{project.data.title}</h1>
      <p class="project-description">{project.data.description}</p>
      
      <div class="project-tech">
        {project.data.technologies.map((tech: string) => (
          <span class="tech-badge">{tech}</span>
        ))}
      </div>
      
      <div class="project-actions">
        {project.data.liveUrl && (
          <a href={project.data.liveUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
            View Live
          </a>
        )}
        {project.data.githubUrl && (
          <a href={project.data.githubUrl} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
        )}
      </div>
      
      <p class="project-date">Completed {formattedDate}</p>
    </header>
    
    {project.data.coverImage && (
      <div class="project-cover">
        <img src={project.data.coverImage} alt={project.data.title} />
      </div>
    )}
    
    <div class="project-content prose">
      <Content />
    </div>
    
    <footer class="project-footer">
      <a href="/projects" class="btn btn-secondary">View all projects</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .project-page {
    max-width: 900px;
  }
  
  .project-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }
  
  .back-link {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
    transition: color var(--transition-fast);
  }
  
  .back-link:hover {
    color: var(--color-primary);
  }
  
  .featured-badge {
    display: inline-block;
    margin-bottom: var(--space-4);
  }
  
  .project-header h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }
  
  .project-description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 700px;
    margin: 0 auto var(--space-6);
  }
  
  .project-tech {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }
  
  .tech-badge {
    padding: var(--space-1) var(--space-3);
    background: var(--color-bg-tertiary);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  
  .project-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  
  .project-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  
  .project-cover {
    margin-bottom: var(--space-12);
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  
  .project-cover img {
    width: 100%;
    height: auto;
  }
  
  /* Prose styles */
  .project-content {
    line-height: var(--line-height-relaxed);
  }
  
  .project-content :global(h2) {
    font-size: var(--text-2xl);
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  
  .project-content :global(h3) {
    font-size: var(--text-xl);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }
  
  .project-content :global(p) {
    margin-bottom: var(--space-6);
    color: var(--color-text-secondary);
  }
  
  .project-content :global(ul),
  .project-content :global(ol) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }
  
  .project-content :global(li) {
    margin-bottom: var(--space-2);
    color: var(--color-text-secondary);
  }
  
  .project-content :global(strong) {
    color: var(--color-text-primary);
  }
  
  .project-footer {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
}).format(project.data.completedDate);
---

<BaseLayout title={`${project.data.title} - Projects`} description={project.data.description}>
  <article class="container project-page animate-fade-in">
    <header class="project-header">
      <a href="/projects" class="back-link">← back to projects</a>
      <h1 class="project-title">{project.data.title}</h1>
      <p class="project-description">{project.data.description}</p>
      {project.data.outcome && <p class="project-outcome"><span>Outcome:</span> {project.data.outcome}</p>}
      
      <div class="project-tech">
        {project.data.technologies.map((tech: string) => (
          <span class="tech-badge">{tech}</span>
        ))}
      </div>
      
      <div class="project-actions">
        {project.data.liveUrl && (
          <a href={project.data.liveUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
            view live
          </a>
        )}
        {project.data.githubUrl && (
          <a href={project.data.githubUrl} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
            view github
          </a>
        )}
      </div>
      
      <p class="project-date">Completed {formattedDate}</p>
    </header>
    
    {project.data.coverImage && (
      <div class="project-cover card">
        <img src={project.data.coverImage} alt={project.data.title} />
      </div>
    )}
    
    <div class="project-content prose">
      <Content />
    </div>
    
    <footer class="project-footer">
      <a href="/projects" class="btn btn-secondary">view all projects</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .project-page {
    max-width: 820px;
    padding-top: clamp(100px, 12vw, 150px);
    padding-bottom: 80px;
  }
  
  .project-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }
  
  .back-link {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: 24px;
    transition: color var(--transition-fast);
  }
  
  .back-link:hover {
    color: var(--color-accent);
  }

  .project-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    margin-bottom: 16px;
    letter-spacing: -0.03em;
  }
  
  .project-description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 660px;
    margin: 0 auto 28px;
    line-height: 1.6;
  }
  
  .project-outcome {
    max-width: 660px;
    margin: -12px auto 28px;
    color: var(--color-text-secondary);
    font-size: 14px;
    line-height: 1.6;
  }

  .project-outcome span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .project-tech {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }

  .project-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-bottom: 24px;
  }

  .project-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  
  .project-cover {
    margin-bottom: var(--space-12);
    border-radius: var(--radius-lg);
    overflow: hidden;
    padding: 0;
  }
  
  .project-cover img {
    width: 100%;
    height: auto;
    display: block;
  }
  
  /* Prose styles */
  .project-content {
    line-height: var(--line-height-relaxed);
  }
  
  .project-content :global(h2) {
    font-size: var(--text-2xl);
    margin-top: 40px;
    margin-bottom: 16px;
    padding-top: 24px;
    border-top: 1px dashed var(--color-border);
  }
  
  .project-content :global(h3) {
    font-size: var(--text-xl);
    margin-top: 32px;
    margin-bottom: 12px;
  }
  
  .project-content :global(p) {
    margin-bottom: 20px;
    color: var(--color-text-secondary);
  }
  
  .project-content :global(ul),
  .project-content :global(ol) {
    margin-bottom: 20px;
    padding-left: 20px;
  }
  
  .project-content :global(li) {
    margin-bottom: 8px;
    color: var(--color-text-secondary);
  }
  
  .project-content :global(strong) {
    color: var(--color-text);
  }
  
  .project-footer {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px dashed var(--color-border);
    text-align: center;
  }
</style>

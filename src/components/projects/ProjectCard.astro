---
interface Props {
  title: string;
  description: string;
  technologies: string[];
  slug: string;
  githubUrl?: string;
  liveUrl?: string;
  coverImage?: string;
  outcome?: string;
  featured?: boolean;
}

const {
  title,
  description,
  technologies,
  slug,
  githubUrl,
  liveUrl,
  coverImage,
  outcome,
  featured,
} = Astro.props;
---

<article class:list={["project-card", "card", { featured }]}> 
  <a href={`/projects/${slug}`} class="project-main" aria-label={`View details for ${title}`}>
    {coverImage && (
      <div class="project-image-wrapper">
        <img src={coverImage} alt={title} loading="lazy" class="project-img" />
      </div>
    )}
    <div class="project-content">
      <div class="project-header">
        {featured && <span class="featured-badge">Featured Build</span>}
        <h3>{title}</h3>
      </div>
      <p>{description}</p>
      {outcome && <p class="project-outcome"><span>Outcome</span>{outcome}</p>}
      <div class="project-tech">
        {technologies.slice(0, 4).map((tech) => <span class="tech-badge">{tech}</span>)}
      </div>
    </div>
  </a>

  <div class="project-actions">
    <a href={`/projects/${slug}`} class="action-link">details →</a>
    {liveUrl && (
      <a href={liveUrl} class="action-link" target="_blank" rel="noopener noreferrer">live demo ↗</a>
    )}
    {githubUrl && (
      <a href={githubUrl} class="action-link" target="_blank" rel="noopener noreferrer">github code ↗</a>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .project-card.featured {
    border-color: rgba(56, 189, 248, 0.2);
    box-shadow: 0 4px 24px rgba(56, 189, 248, 0.02);
  }

  .project-main {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    color: inherit;
  }

  .project-image-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background: #0d111b;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .project-card:hover .project-img {
    transform: scale(1.03);
  }

  .project-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    flex-grow: 1;
  }

  .project-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .featured-badge {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  h3 {
    font-size: 18px;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  p {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  .project-outcome {
    display: grid;
    gap: 4px;
    margin-top: 4px;
    padding-top: 12px;
    border-top: 1px dashed rgba(255, 255, 255, 0.05);
    font-size: 12px;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  .project-outcome span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 14px;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 16px 24px;
    border-top: 1px solid var(--color-border);
    background: rgba(14, 19, 32, 0.15);
    font-family: var(--font-primary);
  }

  .action-link {
    color: var(--color-text-secondary);
    font-size: 13px;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .action-link:hover {
    color: var(--color-accent);
  }
</style>

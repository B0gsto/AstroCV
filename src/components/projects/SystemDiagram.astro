---
// Animated architecture diagram. Nodes and edges come from src/data/diagrams.ts;
// packets travel along each edge, the diagram assembles itself when it scrolls
// into view, and hovering a node isolates what it talks to.
import type { Diagram, DiagramNode } from "../../data/diagrams";

interface Props {
  name: string;
  diagram: Diagram;
}

const { name, diagram } = Astro.props;
const { nodes, edges, width = 1000, height = 400, caption } = diagram;

const NODE_W = 184;
const NODE_H = 58;
const uid = `sd-${name}`;

const byId = new Map(nodes.map((node) => [node.id, node]));
const nodeW = (node: DiagramNode) => node.w ?? NODE_W;

function edgePath(a: DiagramNode, b: DiagramNode) {
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  if (Math.abs(dx) >= Math.abs(dy) * 1.2) {
    const dir = Math.sign(dx) || 1;
    const sx = a.x + (dir * nodeW(a)) / 2;
    const ex = b.x - (dir * nodeW(b)) / 2 - dir * 7;
    const mid = (ex - sx) / 2;
    return {
      d: `M${sx} ${a.y} C${sx + mid} ${a.y} ${ex - mid} ${b.y} ${ex} ${b.y}`,
      lx: (sx + ex) / 2,
      ly: (a.y + b.y) / 2,
    };
  }
  const dir = Math.sign(dy) || 1;
  const sy = a.y + (dir * NODE_H) / 2;
  const ey = b.y - (dir * NODE_H) / 2 - dir * 7;
  const mid = (ey - sy) / 2;
  return {
    d: `M${a.x} ${sy} C${a.x} ${sy + mid} ${b.x} ${ey - mid} ${b.x} ${ey}`,
    lx: (a.x + b.x) / 2,
    ly: (sy + ey) / 2,
  };
}

const drawnEdges = edges.map((edge, i) => ({
  ...edge,
  i,
  ...edgePath(byId.get(edge.from)!, byId.get(edge.to)!),
  packets: edge.packets ?? 1,
  dur: edge.dur ?? 3.2,
}));

const neighbours = (id: string) =>
  [id, ...edges.filter((e) => e.from === id || e.to === id).map((e) => (e.from === id ? e.to : e.from))].join(" ");

// hovering a node dims everything it is not connected to
const focusCss = nodes
  .map(
    ({ id }) => `
#${uid}:has([data-node="${id}"]:hover) .sd-node:not([data-near~="${id}"]),
#${uid}:has([data-node="${id}"]:hover) .sd-edge:not([data-a="${id}"]):not([data-b="${id}"]){opacity:.18}`,
  )
  .join("");
---

<style is:inline set:html={focusCss}></style>

<figure class="sd" id={uid} data-reveal>
  <div class="sd-scroll">
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={caption} style={`--count:${nodes.length};`}>
      <defs>
        <marker id={`${uid}-arrow`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M1.5 1.5 L8 5 L1.5 8.5" fill="none" stroke="#a1a1a6" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </marker>
      </defs>

      {
        drawnEdges.map((edge) => (
          <g class="sd-edge" data-a={edge.from} data-b={edge.to} style={`--e:${edge.i};`}>
            <path
              class:list={["sd-line", { "sd-line-dashed": edge.dashed }]}
              d={edge.d}
              pathLength={edge.dashed ? undefined : "1"}
              marker-end={`url(#${uid}-arrow)`}
            />
            {edge.label && (
              <text class="sd-edge-label" x={edge.lx} y={edge.ly - 9} text-anchor="middle">{edge.label}</text>
            )}
            <g class="sd-packets">
              {Array.from({ length: edge.packets }, (_, k) => (
                <circle class:list={["sd-packet", { "sd-packet-muted": edge.dashed }]} r="4.5">
                  <animateMotion
                    dur={`${edge.dur}s`}
                    begin={`${(-(k * edge.dur) / edge.packets - edge.i * 0.37).toFixed(2)}s`}
                    repeatCount="indefinite"
                    path={edge.d}
                    calcMode="spline"
                    keyTimes="0;1"
                    keySplines="0.45 0 0.55 1"
                  />
                </circle>
              ))}
            </g>
          </g>
        ))
      }

      {
        nodes.map((node, i) => (
          <g
            class:list={["sd-node", `sd-${node.kind ?? "core"}`]}
            data-node={node.id}
            data-near={neighbours(node.id)}
            style={`--i:${i};`}
          >
            <rect
              x={node.x - nodeW(node) / 2}
              y={node.y - NODE_H / 2}
              width={nodeW(node)}
              height={NODE_H}
              rx={node.kind === "person" ? NODE_H / 2 : 16}
            />
            <text class="sd-label" x={node.x} y={node.sub ? node.y - 3 : node.y + 5} text-anchor="middle">{node.label}</text>
            {node.sub && <text class="sd-sub" x={node.x} y={node.y + 15} text-anchor="middle">{node.sub}</text>}
          </g>
        ))
      }
    </svg>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .sd {
    /* break out of the text column, centred on it */
    width: min(1040px, calc(100vw - 2 * var(--container-padding)));
    margin: 0 0 56px 50%;
    translate: -50% 0;
    padding: clamp(20px, 3vw, 36px) clamp(12px, 2.4vw, 32px) 24px;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .sd-scroll {
    overflow-x: auto;
    scrollbar-width: none;
  }

  .sd-scroll::-webkit-scrollbar {
    display: none;
  }

  svg {
    display: block;
    width: 100%;
    min-width: 760px;
    height: auto;
    overflow: visible;
    font-family: var(--font-primary);
  }

  figcaption {
    margin-top: 18px;
    font-size: 14px;
    line-height: 1.5;
    text-align: center;
    color: var(--color-text-muted);
  }

  /* ---- nodes ---- */

  .sd-node {
    cursor: default;
    transition: opacity 0.35s ease;
  }

  .sd-node rect {
    fill: var(--color-bg);
    stroke: transparent;
    stroke-width: 1.5;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.07)) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.05));
    transform-box: fill-box;
    transform-origin: center;
    transition: scale 0.45s var(--ease-out), stroke 0.25s ease;
  }

  .sd-node:hover rect {
    scale: 1.045;
    stroke: var(--color-text);
  }

  .sd-label {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    fill: var(--color-text);
  }

  .sd-sub {
    font-size: 12px;
    fill: var(--color-text-muted);
  }

  /* things I don't own: other people's systems */
  .sd-external rect {
    fill: transparent;
    stroke: var(--color-border-hover);
    stroke-dasharray: 5 4;
    filter: none;
  }

  /* where state lives */
  .sd-store rect {
    fill: #e8e8ed;
    filter: none;
  }

  /* the part the case study is about */
  .sd-key rect {
    fill: var(--color-mark);
  }

  /* people in the loop */
  .sd-person rect {
    stroke: var(--color-text);
  }

  /* ---- edges ---- */

  .sd-edge {
    transition: opacity 0.35s ease;
  }

  .sd-line {
    fill: none;
    stroke: #a1a1a6;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .sd-line-dashed {
    stroke-dasharray: 5 5;
  }

  .sd-edge-label {
    font-size: 12px;
    fill: var(--color-text-secondary);
    paint-order: stroke;
    stroke: var(--color-surface);
    stroke-width: 6px;
    stroke-linejoin: round;
  }

  .sd-packet {
    fill: var(--color-text);
  }

  .sd-packet-muted {
    fill: #a1a1a6;
  }

  /* ---- assembly: nodes land one by one, then the wiring draws itself ---- */

  :global(html.js) .sd:not(.is-in) .sd-node,
  :global(html.js) .sd:not(.is-in) .sd-edge {
    opacity: 0;
  }

  @keyframes sdNodeIn {
    from {
      opacity: 0;
      translate: 0 16px;
      scale: 0.94;
    }
  }

  @keyframes sdLineIn {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }

  @keyframes sdFadeIn {
    from { opacity: 0; }
  }

  .sd.is-in .sd-node {
    transform-box: fill-box;
    transform-origin: center;
    animation: sdNodeIn 0.9s var(--ease-out) backwards;
    animation-delay: calc(0.15s + var(--i) * 70ms);
  }

  .sd.is-in .sd-edge {
    animation: sdFadeIn 0.5s ease backwards;
    animation-delay: calc(0.35s + var(--count) * 70ms + var(--e) * 60ms);
  }

  .sd.is-in .sd-line:not(.sd-line-dashed) {
    stroke-dasharray: 1;
    animation: sdLineIn 0.9s var(--ease-in-out) backwards;
    animation-delay: calc(0.35s + var(--count) * 70ms + var(--e) * 60ms);
  }

  .sd.is-in .sd-line-dashed,
  .sd.is-in .sd-edge-label,
  .sd.is-in .sd-packets {
    animation: sdFadeIn 0.8s ease backwards;
    animation-delay: calc(0.9s + var(--count) * 70ms + var(--e) * 60ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .sd-packets {
      display: none;
    }
  }
</style>

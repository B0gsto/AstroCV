---
const experiences = [
  {
    title: "Software Engineer",
    company: "Automatify",
    period: "2026-03 → present",
    description:
      "Azure infrastructure, CI/CD pipelines, React Native apps and AI-powered workflow systems.",
    current: true,
  },
  {
    title: "Automation & Integration Engineer",
    company: "Tquila Automation",
    period: "2023-07 → 2026-03",
    description:
      "Production systems, API integrations, operational reliability and client-facing delivery.",
    current: false,
  },
  {
    title: "Event Organizer",
    company: "OSUBB Cluj-Napoca",
    period: "2022-10 → 2023-09",
    description: "Volunteer work organizing educational events.",
    current: false,
  },
];
---

<div class="timeline-list">
  {
    experiences.map((exp) => (
      <article class:list={["timeline-card", "card", { current: exp.current }]}> 
        <span>{exp.period}</span>
        <h3>{exp.title}</h3>
        <p class="company">{exp.company}</p>
        <p>{exp.description}</p>
      </article>
    ))
  }
</div>

<style>
  .timeline-list {
    display: grid;
    gap: 16px;
    max-width: 820px;
    margin: 0 auto;
  }

  .timeline-card {
    padding: 24px;
  }

  .timeline-card > * {
    position: relative;
    z-index: 1;
  }

  .timeline-card.current {
    border-color: rgba(56, 189, 248, 0.35);
  }

  span {
    color: var(--color-primary-light);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  h3 {
    margin: 10px 0 6px;
    font-size: 22px;
  }

  .company {
    color: var(--color-text-primary);
    font-weight: 700;
    margin-bottom: 8px;
  }
</style>

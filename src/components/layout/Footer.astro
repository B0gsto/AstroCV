---
const currentYear = new Date().getFullYear();

const socialLinks = [
  { href: "https://github.com/B0gsto", label: "github", icon: "→" },
  {
    href: "https://www.linkedin.com/in/bogdan-stoica-aa415820a/",
    label: "linkedin",
    icon: "→",
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-terminal">
      <div class="footer-section">
        <div class="terminal-line">
          <span class="prompt">$</span>
          <span class="command">whoami</span>
        </div>
        <div class="footer-output">
          <span class="output-name">&gt;_b0gd4n</span> :: UiPath RPA Engineer
        </div>
        <div class="footer-output footer-location">
          <span class="output-dim">└─ Cluj-Napoca, Romania</span>
        </div>
      </div>

      <div class="footer-section">
        <div class="terminal-line">
          <span class="prompt">$</span>
          <span class="command">cat</span> navigation.txt
        </div>
        <div class="footer-links">
          <a href="/" class="footer-nav-link">[~/cv]</a>
          <a href="/blog" class="footer-nav-link">[~/blog]</a>
          <a href="/projects" class="footer-nav-link">[~/projects]</a>
        </div>
      </div>

      <div class="footer-section">
        <div class="terminal-line">
          <span class="prompt">$</span>
          <span class="command">links</span> --social
        </div>
        <div class="social-links">
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="social-link-terminal"
              >
                <span class="link-bracket">[</span>
                <span class="link-text">{link.label}</span>
                <span class="link-bracket">]</span>
                <span class="link-arrow">{link.icon}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-copyright">
        <span class="prompt">$</span> echo $COPYRIGHT
      </div>
      <div class="footer-output">
        &gt; © {currentYear} bogdan_stoica | Built with <a
          href="https://astro.build"
          target="_blank"
          class="astro-link">Astro</a
        >
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    padding: 48px 0 32px;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    font-family: var(--font-mono);
  }

  .footer-terminal {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 32px;
  }

  .footer-section {
    font-size: var(--text-sm);
  }

  .terminal-line {
    margin-bottom: var(--space-3);
  }

  .prompt {
    color: var(--color-primary);
    font-weight: bold;
  }

  .command {
    color: var(--color-accent);
  }

  .footer-output {
    color: var(--color-text-secondary);
    padding-left: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .output-name {
    color: var(--color-primary);
    font-weight: 600;
  }

  .output-dim {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-2);
  }

  .footer-nav-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-nav-link:hover {
    color: var(--color-primary);
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-2);
  }

  .social-link-terminal {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .social-link-terminal:hover {
    color: var(--color-primary);
  }

  .link-bracket {
    color: var(--color-text-muted);
  }

  .link-text {
    color: var(--color-accent);
  }

  .social-link-terminal:hover .link-text {
    color: var(--color-primary);
  }

  .link-arrow {
    color: var(--color-primary);
    opacity: 0;
    transform: translateX(-4px);
    transition: all var(--transition-fast);
  }

  .social-link-terminal:hover .link-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .footer-bottom {
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .footer-copyright {
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
  }

  .astro-link {
    color: var(--color-accent);
    text-decoration: none;
  }

  .astro-link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .footer-terminal {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .social-links {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-4);
    }
  }
</style>

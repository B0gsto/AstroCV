---
const currentYear = new Date().getFullYear();

const socialLinks = [
  { href: "/cv", label: "cv" },
  { href: "https://github.com/B0gsto", label: "github" },
  {
    href: "https://www.linkedin.com/in/bogdan-stoica-aa415820a/",
    label: "linkedin",
  },
  { href: "mailto:bogdan10andrei@gmail.com", label: "email" },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-left">
      <p class="footer-brand">bogdan<span class="logo-accent">.</span>stoica</p>
      <p class="footer-tagline">
        // cloud, integrations and product engineering from cluj-napoca
      </p>
    </div>

    <div class="footer-links">
      {
        socialLinks.map((link, i) => (
          <>
            <a
              href={link.href}
              target={link.href.startsWith("mailto:") || link.href.startsWith("/") ? undefined : "_blank"}
              rel={link.href.startsWith("mailto:") || link.href.startsWith("/") ? undefined : "noopener noreferrer"}
              class="footer-link-item"
            >
              {link.label}
            </a>
            {i < socialLinks.length - 1 && <span class="sep">/</span>}
          </>
        ))
      }
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {currentYear} bogdan stoica. built with astro, restraint and precision.</span>
  </div>
</footer>

<style>
  .site-footer {
    padding: 60px 0 32px;
    border-top: 1px dashed rgba(56, 189, 248, 0.08);
    background: rgba(8, 11, 17, 0.4);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .footer-brand {
    color: var(--color-text);
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: 15px;
  }

  .logo-accent {
    color: var(--color-accent);
  }

  .footer-tagline {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    margin-top: 6px;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-link-item {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 13px;
    transition: color var(--transition-fast);
  }

  .footer-link-item:hover {
    color: var(--color-accent);
  }

  .sep {
    color: var(--color-border);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .footer-bottom {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    display: flex;
    justify-content: space-between;
  }

  @media (max-width: 720px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    
    .footer-links {
      gap: 8px;
    }
  }
</style>

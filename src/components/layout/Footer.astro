---
const currentYear = new Date().getFullYear();

const socialLinks = [
  { href: "/cv", label: "CV" },
  { href: "https://github.com/B0gsto", label: "GitHub" },
  {
    href: "https://www.linkedin.com/in/bogdan-stoica-aa415820a/",
    label: "LinkedIn",
  },
  { href: "mailto:bogdan10andrei@gmail.com", label: "Email" },
];

const isExternal = (href: string) => !href.startsWith("mailto:") && !href.startsWith("/");
---

<footer class="site-footer">
  <div class="container footer-inner">
    <span>© {currentYear} Bogdan Stoica · Cluj-Napoca, Romania</span>

    <div class="footer-links">
      {
        socialLinks.map((link) => (
          <a
            href={link.href}
            target={isExternal(link.href) ? "_blank" : undefined}
            rel={isExternal(link.href) ? "noopener noreferrer" : undefined}
            class="footer-link-item"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 28px 0 36px;
    border-top: 1px solid var(--color-border);
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
  }

  .footer-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 28px;
  }

  .footer-link-item {
    color: var(--color-text-secondary);
    padding: 10px 0;
  }

  .footer-link-item:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

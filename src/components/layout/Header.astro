---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/#about", label: "About" },
  { href: "/projects", label: "Work" },
  { href: "/blog", label: "Writing" },
  { href: "/cv", label: "CV" },
];

const isActive = (href: string) => !href.includes("#") && currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">Bogdan Stoica</a>

    <nav class="nav" aria-label="Primary navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={["nav-link", { active: isActive(link.href) }]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a href="mailto:bogdan10andrei@gmail.com?subject=Hello%20Bogdan" class="btn btn-primary header-contact">
      Get in touch
    </a>
  </div>
</header>

<style>
  /* a translucent material: content scrolls under it and stays legible */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--color-border);
    transition: transform 0.5s var(--ease-out);
  }

  :global(html.header-hidden) .site-header {
    transform: translateY(-100%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: var(--header-height);
  }

  .brand {
    padding: 10px 0;
    color: var(--color-text);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .brand:hover {
    color: var(--color-text);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 30px;
    margin-left: auto;
  }

  .nav-link {
    padding: 12px 0;
    color: var(--color-text-secondary);
    font-size: 14px;
    letter-spacing: -0.005em;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
  }

  .header-contact {
    min-height: 32px;
    padding: 0 14px;
    font-size: 13px;
  }

  @media (max-width: 720px) {
    .header-contact {
      display: none;
    }

    .nav {
      gap: 20px;
    }
  }

  @media (max-width: 400px) {
    .nav-link[href="/#about"] {
      display: none;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--color-bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>

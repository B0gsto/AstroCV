---
// Boot sequence animation component
// Shows terminal-style initialization on first visit
---

<div class="boot-overlay" id="boot-overlay">
    <div class="boot-container">
        <div class="boot-terminal">
            <div class="boot-line" data-delay="0">
                <span class="prompt">$</span>
                <span class="command">init</span> bogdan_cv.exe
            </div>
            <div class="boot-line" data-delay="400">
                <span class="status">[▓▓▓▓▓▓▓▓▓▓]</span> Initializing CV system...
            </div>
            <div class="boot-line" data-delay="800">
                <span class="prompt">></span> Loading skills module... <span
                    class="success">[OK]</span
                >
            </div>
            <div class="boot-line" data-delay="1200">
                <span class="prompt">></span> Loading experience data... <span
                    class="success">[OK]</span
                >
            </div>
            <div class="boot-line" data-delay="1600">
                <span class="prompt">></span> Compiling projects... <span
                    class="success">[OK]</span
                >
            </div>
            <div class="boot-line" data-delay="2000">
                <span class="prompt">></span> Establishing connection... <span
                    class="success">[OK]</span
                >
            </div>
            <div class="boot-line ready" data-delay="2400">
                <span class="prompt">$</span>
                <span class="ready-text">System ready.</span>
                <span class="cursor">█</span>
            </div>
        </div>
    </div>
</div>

<script>
    // Check if boot sequence has been shown this session
    const hasSeenBoot = sessionStorage.getItem("boot-seen");
    const overlay = document.getElementById("boot-overlay");

    if (hasSeenBoot) {
        // Hide immediately if already seen
        if (overlay) overlay.style.display = "none";
    } else {
        // Show boot sequence
        const lines = document.querySelectorAll(".boot-line");

        lines.forEach((line, index) => {
            const delay = parseInt(line.getAttribute("data-delay") || "0");
            setTimeout(() => {
                line.classList.add("visible");
            }, delay);
        });

        // Hide overlay after animation completes
        setTimeout(() => {
            if (overlay) {
                overlay.classList.add("fade-out");
                setTimeout(() => {
                    overlay.style.display = "none";
                    sessionStorage.setItem("boot-seen", "true");
                }, 500);
            }
        }, 3200);
    }
</script>

<style>
    .boot-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: #0a0a0a;
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.5s ease;
    }

    .boot-overlay.fade-out {
        opacity: 0;
    }

    .boot-container {
        max-width: 600px;
        width: 90%;
    }

    .boot-terminal {
        font-family: "JetBrains Mono", monospace;
        font-size: 14px;
        line-height: 1.8;
        color: #c9d1d9;
    }

    .boot-line {
        opacity: 0;
        transform: translateY(5px);
        transition:
            opacity 0.3s ease,
            transform 0.3s ease;
        padding: 2px 0;
    }

    .boot-line.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .prompt {
        color: #00ff41;
        font-weight: bold;
    }

    .command {
        color: #00d4ff;
    }

    .status {
        color: #00ff41;
        font-size: 12px;
    }

    .success {
        color: #00ff41;
        font-weight: bold;
    }

    .ready-text {
        color: #00ff41;
        text-shadow: 0 0 10px rgba(0, 255, 65, 0.5);
    }

    .cursor {
        color: #00ff41;
        animation: blink 1s step-end infinite;
    }

    @keyframes blink {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0;
        }
    }

    @media (max-width: 768px) {
        .boot-terminal {
            font-size: 12px;
        }
    }
</style>

---
interface Props {
  title: string;
  description: string;
  publishDate: Date;
  tags: string[];
  slug: string;
  coverImage?: string;
}

const { title, description, publishDate, tags, slug, coverImage } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishDate);

// Estimate reading time (rough calculation)
const readingTime = '5 min read';
---

<article class="blog-card card hover-lift">
  <a href={`/blog/${slug}`} class="blog-card-link">
    {coverImage && (
      <div class="blog-card-image">
        <img src={coverImage} alt={title} loading="lazy" />
      </div>
    )}
    <div class="blog-card-content">
      <div class="blog-card-meta">
        <time datetime={publishDate.toISOString()}>{formattedDate}</time>
        <span class="separator">-</span>
        <span>{readingTime}</span>
      </div>
      
      <h3 class="blog-card-title">{title}</h3>
      <p class="blog-card-description">{description}</p>
      
      <div class="blog-card-tags">
        {tags.slice(0, 3).map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
      
      <span class="blog-card-cta">
        Read article
      </span>
    </div>
  </a>
</article>

<style>
  .blog-card {
    overflow: hidden;
  }
  
  .blog-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  
  .blog-card-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    margin: calc(var(--space-6) * -1);
    margin-bottom: var(--space-4);
  }
  
  .blog-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }
  
  .blog-card:hover .blog-card-image img {
    transform: scale(1.05);
  }
  
  .blog-card-content {
    padding-top: var(--space-4);
  }
  
  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }
  
  .separator {
    color: var(--color-border);
  }
  
  .blog-card-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
    transition: color var(--transition-fast);
  }
  
  .blog-card:hover .blog-card-title {
    color: var(--color-primary);
  }
  
  .blog-card-description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .blog-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  
  .blog-card-cta {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
  }
</style>

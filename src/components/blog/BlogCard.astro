---
interface Props {
  title: string;
  description: string;
  publishDate: Date;
  tags: string[];
  slug: string;
  coverImage?: string;
}

const { title, description, publishDate, tags, slug, coverImage } = Astro.props;

const formattedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
}).format(publishDate);
---

<article class="blog-card card">
  <a href={`/blog/${slug}`} class="blog-card-link" aria-label={`Read article: ${title}`}>
    {coverImage && (
      <div class="blog-card-image-wrapper">
        <img src={coverImage} alt={title} loading="lazy" class="blog-card-img" />
      </div>
    )}
    <div class="blog-card-content">
      <div class="blog-card-meta">
        <time datetime={publishDate.toISOString()} class="mono-date">{formattedDate}</time>
      </div>
      <h3>{title}</h3>
      <p>{description}</p>
      <div class="blog-card-tags">
        {tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
      </div>
      <span class="blog-card-cta">read article →</span>
    </div>
  </a>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .blog-card-link {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    color: inherit;
  }

  .blog-card-image-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background: #0d111b;
  }

  .blog-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .blog-card:hover .blog-card-img {
    transform: scale(1.03);
  }

  .blog-card-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    flex-grow: 1;
  }

  .blog-card-meta {
    margin-bottom: 2px;
  }

  .mono-date {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
  }

  h3 {
    font-size: 18px;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  p {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin-bottom: auto;
  }

  .blog-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .blog-card-cta {
    margin-top: 16px;
    color: var(--color-accent);
    font-family: var(--font-primary);
    font-size: 13px;
    font-weight: 600;
    transition: color var(--transition-fast);
  }

  .blog-card:hover .blog-card-cta {
    color: var(--color-text);
  }
</style>

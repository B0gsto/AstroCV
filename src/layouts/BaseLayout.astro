---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import "../styles/global.css";
import "../styles/animations.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogPath?: string;
  robots?: string;
}

const {
  title,
  description = "Bogdan Stoica — Software Engineer building cloud, web, mobile and AI workflow systems.",
  canonicalPath,
  ogPath,
  robots,
} = Astro.props;
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogURL = new URL(ogPath ?? Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/og-image.svg", Astro.site);
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Bogdan Stoica",
  jobTitle: "Software Engineer",
  url: Astro.site?.toString(),
  image: new URL("/images/profile.jpg", Astro.site).toString(),
  email: "mailto:bogdan10andrei@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Cluj-Napoca",
    addressCountry: "RO",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Babeș-Bolyai University",
  },
  knowsAbout: [
    "Microsoft Azure",
    "Next.js",
    "React Native",
    "REST API integrations",
    "OAuth",
    "AI document automation",
    "Azure Document Intelligence",
    "Dynamics 365",
    "AI workflow systems",
    "DevOps",
  ],
  sameAs: [
    "https://github.com/B0gsto",
    "https://www.linkedin.com/in/bogdan-stoica-aa415820a/",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)}></script>

    <!-- Arms scroll reveals only when JS runs, so content is never hidden without a way back -->
    <script is:inline>
      // "js" lets CSS hide content that is waiting to be revealed. If the motion
      // module has not reported in shortly after, show everything: content must
      // never depend on a script arriving.
      (function () {
        var root = document.documentElement;
        var arm = function () {
          root.classList.add("js");
          setTimeout(function () {
            if (!window.__motionReady) root.classList.remove("js");
          }, 2500);
        };
        arm();
        document.addEventListener("astro:after-swap", function () {
          if (window.__motionReady) root.classList.add("js");
          else arm();
        });
      })();
    </script>
    <ClientRouter />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <Header />
      <main class="main page-transition">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      import "../scripts/motion.js";
    </script>
  </body>
</html>

<style>
  .site-shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .main {
    flex: 1;
    padding-top: var(--header-height);
  }
</style>
